# Template for local environment variables: cp .env.example .env

# ---- Infra (docker-compose) ----
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
RABBITMQ_USER=taskflow
RABBITMQ_PASSWORD=taskflow
# Host ports (change when another service already uses them)
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- API ----
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://taskflow:taskflow@localhost:5672
CORS_ORIGIN=http://localhost:5173
# Generate with: openssl rand -base64 48 (at least 32 characters)
JWT_ACCESS_SECRET=change-me-to-a-random-secret-of-32-chars-or-more
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Browser-side path of the auth routes (the /api prefix is stripped by the Vite proxy and nginx)
REFRESH_COOKIE_PATH=/api/auth

# Rate limits: per-IP sliding window on auth routes, per-user token bucket on the business API
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_CAPACITY=60
RATE_LIMIT_API_REFILL_PER_SECOND=2

# ---- Background jobs and email (REQ-006) ----
# Base URL of the web app, used in emailed links
WEB_URL=http://localhost:5173
# Mailpit catches all mail locally; open http://localhost:8025 to read it
SMTP_URL=smtp://localhost:1025
MAIL_FROM=TaskFlow <no-reply@taskflow.local>
# Run BullMQ workers inside this process (set false for an API-only process; see npm run start:worker)
RUN_WORKERS=true
# Cron pattern for the due-task scan (6 fields allowed for seconds, e.g. */10 * * * * *)
REMINDER_CRON=*/5 * * * *
REMINDER_WINDOW_HOURS=24
INVITATION_TTL_DAYS=7
