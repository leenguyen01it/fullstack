{
  "name": "taskflow",
  "private": true,
  "version": "0.1.0",
  "description": "TaskFlow - fullstack learning project (React, Node.js, TypeScript, PostgreSQL, Redis, RabbitMQ)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d postgres redis rabbitmq mailpit",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "build:shared": "npm run build -w @taskflow/shared",
    "dev:api": "npm run dev -w @taskflow/api",
    "dev:web": "npm run dev -w @taskflow/web",
    "dev": "npm run build:shared && concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w @taskflow/api --",
    "db:studio": "npm run db:studio -w @taskflow/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "prisma": "7.10.1"
  }
}
